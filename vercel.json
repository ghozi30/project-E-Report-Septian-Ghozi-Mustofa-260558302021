{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/build/$1"
    },
    {
      "src": "/(css|js|images|fonts|favicon|storage)/(.*)",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*)\\.(ico|json|txt|xml|png|jpg|jpeg|svg|webp|woff|woff2)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:w54quU33vMXpT6XKuofG+c/SUi7e2QvVt1f9M0zuV7o=",
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "aws-0-ap-southeast-1.pooler.supabase.com",
    "DB_PORT": "6543",
    "DB_DATABASE": "postgres",
    "DB_USERNAME": "postgres.aqnfwqlzkywfiouplhmv",
    "DB_PASSWORD": "Sep_Ghozi_Mus",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "APP_CONFIG_CACHE": "/tmp/storage/framework/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/storage/framework/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/storage/framework/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/storage/framework/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/storage/framework/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
  }
}
